---
// ============================================================
// SMALL BUSINESS HUB — from the "Small Business" screen in
// EIP - Pages.dc.html. Custom pipelines that optimise for the stop-loss.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';

const metadata = {
  title: 'Small Business Hub — The Ethical Intelligence Project',
  description:
    'Before you spend a dollar chasing new revenue, a custom pipeline learns how your operation actually runs, finds where money is quietly leaving, and closes it.',
};

const PIPELINE = [
  {
    n: '01 · LEARN',
    title: 'It learns your business',
    body: 'Your invoices, product mix, point-of-sale, costs. Built around the data you already generate — nothing new to maintain.',
  },
  {
    n: '02 · WATCH',
    title: 'It watches the variance',
    body: 'Every week it compares what things should cost with what they actually cost: supplier creep, portion drift, margin erosion.',
  },
  {
    n: '03 · NAME',
    title: 'It names one bottleneck',
    body: 'Not a dashboard with forty charts. The single constraint costing you most, how confident it is, and the smallest move that tests it.',
  },
  {
    n: '04 · COMPOUND',
    title: 'Then it keeps going',
    body: 'Clear one constraint and the next becomes visible. The pipeline keeps learning your rhythms while you run the business.',
  },
];

const INCLUDES = [
  { k: 'Data intake', v: 'your existing systems' },
  { k: 'Variance watch', v: 'continuous, automated' },
  { k: 'Constraint report', v: 'one finding, weekly' },
  { k: 'Ask-anything access', v: 'Elle, on your data' },
  { k: 'Pricing', v: 'scoped to the operation' },
];
---

<EipPage metadata={metadata} current="/business">
  <section class="page-hero">
    <div class="tint" style="background:radial-gradient(ellipse 60% 60% at 85% 10%, #17140d 0%, transparent 62%)"></div>
    <div class="inner">
      <div class="kicker">The Small Business Hub · scoped per operation</div>
      <h1>Everyone sells you growth. We start with the leak.</h1>
      <p class="lede" style="margin-bottom:34px">
        Before you spend a dollar chasing new revenue, a custom pipeline learns how your operation actually runs, finds
        where money is quietly leaving, and closes it. A dollar you stop losing is worth exactly as much as a dollar you
        earn — and it is usually far easier to get.
      </p>
      <div class="btn-row">
        <a href="/contact" class="btn btn-gold">Tell us what you run</a>
        <a href="https://rapid2ai.com" class="btn btn-ghost">See RAPID²AI live →</a>
      </div>
    </div>
  </section>

  <section class="on-base">
    <div class="shell sec-y">
      <div class="kicker">How it works</div>
      <h2 class="h2-sm" style="margin-bottom:44px">Built around your operation. Not a template.</h2>
      <div class="tiles c4">
        {
          PIPELINE.map((p) => (
            <div class="tile">
              <div class="n">{p.n}</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="shell sec-y">
      <div class="split" style="gap:72px">
        <div>
          <div class="kicker">Already running</div>
          <h2 class="h2-sm">Proven in the hardest margin business there is.</h2>
          <div class="prose" style="margin-top:22px">
            <p>
              The first of these pipelines — <strong>RAPID²AI</strong> — runs today in hospitality: live food-cost tracking,
              price-variance alerts on every invoice line, menu and POS intelligence, built from inside an industry that runs
              on margin and instinct.
            </p>
            <p style="margin-bottom:28px">
              The Hub takes the same architecture — learn the operation, watch the variance, name the constraint — and
              builds it for yours: retail, trades, farms, professional services, anywhere the books hide a leak.
            </p>
          </div>
          <div class="callout">
            <div class="hd">What a weekly finding looks like</div>
            <p class="q">
              "Dairy invoice line up 11% across three weeks — one supplier, not the market. Smallest move: call before
              Friday's order."
            </p>
            <div class="sub">one finding · not forty charts</div>
          </div>
        </div>
        <div>
          <div class="kicker">What a pipeline includes</div>
          <div class="facts">
            {
              INCLUDES.map((i) => (
                <div class="row">
                  <span class="k">{i.k}</span>
                  <span class="v">{i.v}</span>
                </div>
              ))
            }
          </div>
          <p style="font-size:0.88rem;line-height:1.7;color:var(--t3);margin:18px 0 0">
            Custom builds are scoped per operation — tell us what you run and we'll tell you what the pipeline looks
            like and what it costs. Beta-era clients keep their pricing indefinitely.
          </p>
        </div>
      </div>
    </div>
  </section>
</EipPage>
