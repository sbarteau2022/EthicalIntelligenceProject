---
// 404 — was the AstroWind template page (Tailwind utility classes, light
// theme); rebuilt on the dark Observer shell.
import EipPage from '~/components/eip/EipPage.astro';

const metadata = { title: 'Not found — The Ethical Intelligence Project' };
---

<EipPage metadata={metadata}>
  <section style="border-bottom:0">
    <div class="shell-narrow" style="padding-top:140px;padding-bottom:140px;text-align:center">
      <div class="kicker">Error 404</div>
      <h1 style="margin-bottom:22px">This page isn't on the record.</h1>
      <p class="lede" style="max-width:520px;margin:0 auto 38px">
        Nothing here is quietly removed — but this address was never written. The corpus, the journal and Elle herself
        are all a click away.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a href="/" class="btn btn-gold">Back to the homepage</a>
        <a href="/core-works" class="btn btn-ghost">Read the corpus</a>
        <a href="/elle" class="btn btn-ghost">Ask Elle</a>
      </div>
    </div>
  </section>
</EipPage>
