---
// ============================================================
// ATLAS EDU — from the "Atlas Edu" screen in EIP - Pages.dc.html, but driven
// by the REAL curriculum in ~/data/learn.ts rather than the design's
// placeholder cards, so /learn and the homepage teasers cannot drift.
//
// The design's single static "open lesson" is a <details> accordion here, so
// every lesson body in the data set reads on the page with no signup wall —
// which is what the copy promises. Sign-up still goes through window.EIH.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';
import { LEARN_COURSES, MINUTES_PER_LESSON } from '~/data/learn';

const metadata = {
  title: 'Atlas Edu — AI in plain language',
  description:
    'Free courses in plain language. Every lesson reads on the page — no video, no signup wall — and every lesson is one click from asking Elle about it.',
};

const totalLessons = LEARN_COURSES.reduce((n, c) => n + c.lessons.length, 0);

// **bold** is the only inline markup the lesson bodies use
const md = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<EipPage metadata={metadata} current="/learn">
  <section>
    <div class="shell" style="padding-top:96px;padding-bottom:70px">
      <div class="kicker">Atlas Edu · free, no account needed</div>
      <h1>Understand the thing before you trust it.</h1>
      <p class="lede" style="font-size:1.12rem;max-width:620px">
        {LEARN_COURSES.length} courses, {totalLessons} lessons, in plain language. Every lesson reads on the page — no video,
        no signup wall — and every one is a click from asking Elle about it while it's fresh.
      </p>
    </div>
  </section>

  <!-- catalog -->
  <section class="on-base">
    <div class="shell" style="padding-top:76px;padding-bottom:76px">
      <div class="courses">
        {
          LEARN_COURSES.map((c, i) => (
            <a href={`#course-${c.id}`} class:list={['course', { 'is-open': i === 0 }]}>
              <div class="top">
                <span class="badge">{c.badge}</span>
                <span class="count">{c.lessons.length} lessons</span>
              </div>
              <h3>{c.title}</h3>
              <p>{c.teaser}</p>
              <div class="foot">
                <div class="meta">
                  <span>
                    {c.level} · {c.lessons.length * MINUTES_PER_LESSON} min
                  </span>
                  <span class="cta">Read free →</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- every course, in full -->
  {
    LEARN_COURSES.map((c, ci) => (
      <section id={`course-${c.id}`} class:list={[{ 'on-base': ci % 2 === 1 }]}>
        <div class="shell-narrow sec-y">
          <div class="kicker">{c.badge}</div>
          <h2 class="h2-sm" style="margin-bottom:18px">
            {c.title}
          </h2>
          <p class="lede" style="margin-bottom:32px">
            {c.blurb}
          </p>
          <div class="lessons">
            {c.lessons.map((l, li) => (
              <details open={ci === 0 && li === 0}>
                <summary>
                  <span class="no">{String(li + 1).padStart(2, '0')}</span>
                  <span class="t">{l.title}</span>
                  <span class="mins">{MINUTES_PER_LESSON} min</span>
                  <span class="mark">▾</span>
                </summary>
                <div class="body">
                  {l.body ? (
                    l.body.split(/\n\s*\n/).map((para) => <p set:html={md(para.trim())} />)
                  ) : (
                    <p>Publishing during beta — this lesson is being written now.</p>
                  )}
                  <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <a href={l.ask ? `/elle?q=${encodeURIComponent(l.ask)}` : '/elle'} class="pill-link is-gold">
                      Ask Elle about this →
                    </a>
                    <button class="pill-link eip-signup" type="button">
                      Track my progress
                    </button>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="cta">
    <div class="wash"></div>
    <div class="inner">
      <h2>Completion is earned, not given.</h2>
      <p>
        Elle facilitates the courses; a deterministic engine holds the gate. She can't argue a completion down or
        ghost-write past it — and the log is tamper-evident.
      </p>
      <div class="btn-row">
        <button class="btn btn-gold eip-signup" type="button">Create a free account</button>
        <a href="/elle" class="btn btn-ghost">Ask Elle a question first</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('.eip-signup').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (window.EIH) window.EIH.openAuth('signup');
        });
      });
    })();
  </script>
</EipPage>
