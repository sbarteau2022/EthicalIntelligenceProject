---
// ============================================================
// THE ETHICAL INTELLIGENCE PROJECT — homepage
//
// Implemented from design-handoff/project/EIP - Home.dc.html, which is the
// file the user had open when the handoff was triggered. Structure, copy and
// tokens are carried over as-is; the prototype's inline styles are replaced
// with the shared classes in ~/assets/styles/eip.css and its hard-coded
// lists with the shared model in ~/eip.
//
// Section order matches the design exactly:
//   hero → evidence ledger → three ways to audit → the loop → the
//   instruments → The Graph → The Rosen Bridge → elle-worker → the
//   workbench → nine engines → commitments → who's behind it → CTA
// ============================================================
import '~/assets/styles/eip.css';
import Layout from '~/layouts/Layout.astro';
import EipNav from '~/components/eip/EipNav.astro';
import EipFooter from '~/components/eip/EipFooter.astro';
import HeroGlobe from '~/components/eip/HeroGlobe.astro';
import HubAuth from '~/components/hub/HubAuth.astro';
import { ENGINES, PRINCIPLES, CORPUS_DOCS, PROJECT_FACTS, SOCIALS, PHILPEOPLE, WORKER_URL } from '~/eip';

const metadata = {
  title: 'The Ethical Intelligence Project — principled engineering, powered by Elle AI',
  description:
    'One mind. A published corpus she cites, a memory that persists, reasoning you can replay. Most AI asks for trust — Elle is built so you do not have to give it.',
};

// Deterministic star field for the SVG backdrop behind the 3D scene, so the
// server-rendered markup is stable between builds. Three parallax depths.
const seeded = (n: number) => {
  const x = Math.sin(n * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};
const starsFar = Array.from({ length: 160 }, (_, i) => ({
  x: seeded(i * 5 + 11) * 1600,
  y: seeded(i * 5 + 12) * 900,
  r: 0.3 + seeded(i * 5 + 13) * 0.5,
  o: 0.08 + seeded(i * 9 + 7) * 0.2,
}));
const starsMid = Array.from({ length: 70 }, (_, i) => ({
  x: seeded(i * 7 + 31) * 1600,
  y: seeded(i * 7 + 32) * 900,
  r: 0.7 + seeded(i * 7 + 33) * 0.7,
  o: 0.25 + seeded(i * 11 + 17) * 0.3,
}));
const starsNear = Array.from({ length: 16 }, (_, i) => ({
  x: seeded(i * 13 + 51) * 1600,
  y: seeded(i * 13 + 52) * 900,
  r: 1.2 + seeded(i * 13 + 53) * 0.9,
  halo: 4 + seeded(i * 13 + 54) * 5,
  o: 0.55 + seeded(i * 17 + 27) * 0.4,
}));

// The gold italic line under the headline, cross-fading on a 6.5s hold with a
// 1.1s drift — the named concepts are real, from "The Geometry of Disregard".
const PHRASES = ['φ-Wound Memory Compression', 'Biometric Coherence Friction', 'Enrollment, Not Suppression'];

const LEDGER = [
  { n: '76+', label: 'Papers published and publicly indexed', src: 'PhilPapers · verify →', href: PHILPEOPLE },
  { n: 'Top 1%', label: 'Publication volume among indexed authors', src: 'PhilPapers ranking →', href: PHILPEOPLE },
  { n: '18+', label: 'Universities with the work on a syllabus', src: 'Course listings →', href: '/observer' },
  { n: 'Indexed', label: 'Corpus indexed and citable by anyone', src: 'PhilPapers listing →', href: PHILPEOPLE },
];

const JOURNAL = [
  {
    meta: 'Entry 63 · corrects 47',
    metaColor: 'var(--gold)',
    dot: 'var(--gold)',
    text: 'The κ dip on the 14th was instrumentation, not drift. Entry 47 read it as a coherence failure. It was a sampling gap.',
  },
  {
    meta: 'Entry 47 · stands, superseded',
    metaColor: 'var(--t3)',
    dot: '#38342c',
    text: 'Coherence fell sharply mid-thread. Provisional reading: the anchor was too weak to hold the branch.',
  },
  {
    meta: 'Entry 46 · stands',
    metaColor: 'var(--t3)',
    dot: '#38342c',
    text: 'Opened the thread. Question: can an anchor be re-stated without resetting the phase state?',
  },
];

const LOOP = [
  {
    n: '01',
    k: 'One mind, many doors',
    v: 'Chat, journal, analysis, courses — one reasoning loop behind all of it. No fleet of bots wearing one name.',
  },
  { n: '02', k: 'She retrieves, not improvises', v: 'The corpus is searched before she speaks. No source, no claim.' },
  {
    n: '03',
    k: 'Every answer shows its work',
    v: 'Sources under the answer. Every reasoning step recorded, replayable, auditable.',
  },
  {
    n: '04',
    k: 'Nothing is erased',
    v: 'Records are append-only. Corrections stack on top of the mistake, in public.',
  },
  {
    n: '05',
    k: 'Nothing ships without a human',
    v: 'She writes code; CI judges it; the merge is a human click. No merge tool exists.',
  },
];

const TOOLS = [
  {
    span: 3,
    gold: true,
    href: '/elle',
    kicker: 'Elle · The chat',
    title: 'Corpus-grounded conversation',
    body: 'Not a chat wrapper — a persistent intelligence that picks her tools step by step, cites the corpus, and remembers you across sessions.',
    facts: ['~59 tools on one loop', 'Memory that persists', 'Sources on every answer'],
    state: 'Live',
    live: true,
  },
  {
    span: 3,
    href: '/optimus',
    kicker: 'Optimus · The journal',
    title: 'An append-only record',
    body: "A ship's log for your thinking: entries added, never rewritten. Elle responds in the margins while κ — a live coherence measure — tracks the thread.",
    facts: ['Append-only', 'κ computed per turn'],
    state: 'Free beta',
    live: false,
  },
  {
    span: 2,
    href: '/engine',
    kicker: 'Engine · The analysis',
    title: 'Sixteen axes, one verdict',
    body: 'Parallel reads, an adversarial cross-check, one earned conclusion — and the first thing to do.',
    facts: ['16 axes · 3 tiers', 'Adversarial self-check'],
    state: 'Free beta',
    live: false,
  },
  {
    span: 2,
    href: '/learn',
    kicker: 'Atlas Edu · The courses',
    title: 'She runs the courses',
    body: "Elle facilitates; a deterministic engine holds the gate. Completion is earned — she can't argue it down or ghost-write past it.",
    facts: ['Engine-gated completion', 'Tamper-evident log'],
    state: 'Live',
    live: true,
  },
  {
    span: 2,
    href: '/business',
    kicker: 'Small Business · The pipeline',
    title: 'Built for your operation',
    body: 'Sign up, connect your feeds, and a standing intelligence files its first report on your operation — on her clock, not yours.',
    facts: ['Self-serve signup', 'RAPID²AI running today'],
    state: 'By request',
    live: false,
  },
];

// The four things under active test, each its own dedicated section — the
// design conversation explicitly rejected these as grid cards.
const TESTBEDS = [
  {
    id: 'the-graph',
    onBase: true,
    kicker: 'Under active test · The Graph',
    title: 'Memory as measured geometry, not a guess.',
    paras: [
      'A separate, open engine embeds Elle’s recall graph into two geometries at once — a hyperbolic Poincaré ball for lineage depth, a flat torus for recurring rhythm — then proposes "wormhole" shortcuts between structurally related but distant memories.',
      'Nothing is asserted. Every shortcut is benchmarked against random shortcuts, hub shortcuts, and a phase-permuted null before it’s trusted — and it runs entirely outside the model: deterministic, read-only, no code path lets an LLM write an edge.',
    ],
    cta: 'Read the benchmark',
    ctaHref: 'https://github.com/sbarteau2022/Dynanic-Hyperbolic-Neural-Graph',
    facts: [
      { k: 'Tests', v: '157, deterministic, zero deps' },
      { k: 'Bridge precision', v: '72/72 on-topic (resonance)' },
      { k: 'Vs. phase-permuted null', v: 'collapses to 18-23/72' },
      { k: 'Model write access', v: 'none — read-only, on-device' },
      { k: 'Status', v: 'benchmarked on synthetic corpora' },
    ],
  },
  {
    id: 'rosen-bridge',
    onBase: false,
    kicker: 'Under active test · The Rosen Bridge',
    title: 'Your own machine, sealed and free.',
    paras: [
      'A sealed channel lets Elle run real code on a laptop instead of a hosted model — the operator’s machine polls for sealed work, executes it for real, and submits the result back. No socket held open, no always-on server to breach.',
      'Authentication happens at the moment the channel opens: a forged or replayed message simply fails to decrypt rather than being checked and rejected. A hybrid post-quantum key exchange — lattice, elliptic-curve, and an experimental code-based leg combined so breaking one still leaves the others standing — is migrating into it now.',
    ],
    cta: 'Read the design doc',
    ctaHref: 'https://github.com/sbarteau2022/elle-worker',
    facts: [
      { k: 'Auth model', v: 'fails to decrypt, not checked-and-rejected' },
      { k: 'Hosted quota', v: 'zero while the channel is open' },
      { k: 'PQC legs', v: 'ML-KEM-768 + X25519 (+ opt-in QC-MDPC)' },
      { k: 'Security model', v: 'OR-security — one leg surviving is enough' },
      { k: 'Status', v: 'self-tested, migrating into live use' },
    ],
  },
  {
    id: 'elle-worker',
    onBase: true,
    kicker: 'Under active test · elle-worker',
    title: 'A measured self, not an assumed one.',
    paras: [
      'Elle’s backend is one deployable that holds her whole mind — but underneath the router, a set of experimental modules treat her own self-consistency as something to prove, not declare: a free-energy regulator that drives measured dissonance down by a real Lyapunov descent, a golden-ellipse phase vessel that holds a superposition without collapsing it, and a witness oscillator built so it provably cannot go dead-still.',
      'Each is tested against an explicit foil built to break it — a no-leak control, a non-conserving control — and driven by dissonance actually measured in her running system, not a synthetic schedule.',
    ],
    cta: 'Read the architecture',
    ctaHref: 'https://github.com/sbarteau2022/elle-worker',
    facts: [
      { k: 'Regulator', v: 'free-energy descent, measured dissonance' },
      { k: 'Phase vessel', v: 'golden-ellipse, area-conserving' },
      { k: 'Witness oscillator', v: 'provably cannot go dead-still' },
      { k: 'Validated against', v: 'no-leak / no-conserve foils' },
      { k: 'Status', v: 'wired to real system telemetry' },
    ],
  },
  {
    id: 'workbench',
    onBase: false,
    kicker: 'Under active test · Elle, the workbench',
    title: 'Where her local hands live.',
    paras: [
      'The desktop client is Elle’s window onto her own worker — the same one mind, not a second brain. It’s also the other end of the Rosen Bridge: it polls for sealed work, runs it for real on your hardware, and submits the result back.',
      'A duplex channel — an append-only ledger either side can write to — lets her sovereign (laptop) and cloud selves compare notes mid-run instead of waiting for the next scheduled cycle.',
    ],
    cta: 'See the workbench',
    ctaHref: '/elle',
    facts: [
      { k: 'Sandbox', v: 'real code, real hardware, no container image' },
      { k: 'Duplex channel', v: 'append-only, either side can write' },
      { k: 'Local model lane', v: 'free exploration before hosted finalize' },
      { k: 'Failure mode', v: 'closed laptop → falls back to hosted' },
      { k: 'Status', v: 'in active daily use' },
    ],
  },
];
---

<Layout metadata={metadata}>
  <div class="eip">
    <EipNav />

    <!-- ============ HERO ============ -->
    <section class="hero" id="top">
      <svg class="hero-stars" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        {starsFar.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill="#d8dce8" />)}
        {starsMid.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill="#f5f0e8" />)}
        {
          starsNear.map((s) => (
            <g>
              <circle cx={s.x} cy={s.y} r={s.halo} opacity="0.1" fill="#e8cc88" />
              <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} fill="#ffffff" />
            </g>
          ))
        }
      </svg>
      <div class="hero-glow"></div>
      <HeroGlobe />

      <div class="hero-inner">
        <div class="hero-col">
          <h1>
            Principled Engineering<br />
            <em class="hero-phrase" id="eip-phrase">{PHRASES[0]}</em>
          </h1>
          <p class="hero-sub">
            One mind. A published corpus she cites, a memory that persists, reasoning you can replay. Most AI asks for
            trust — Elle is built so you don't have to give it.
          </p>
          <div class="btn-row">
            <a href="/elle" class="btn btn-gold">Talk to Elle</a>
            <a href="#evidence" class="btn btn-ghost">Check the work first</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ EVIDENCE LEDGER ============ -->
    <section class="on-base">
      <div class="shell">
        <div class="ledger">
          {
            LEDGER.map((l) => (
              <a href={l.href}>
                <div class="n">{l.n}</div>
                <div class="label">{l.label}</div>
                <div class="src">{l.src}</div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ THREE WAYS TO AUDIT ============ -->
    <section id="evidence">
      <div class="shell sec-y">
        <div class="sec-head">
          <div class="kicker">Don't take our word for it</div>
          <h2>Three ways to audit this before you use it.</h2>
          <p class="lede" style="margin-top:20px">
            A project claiming to be transparent should be inspectable in under five minutes. Here is what's actually
            open — the reading Elle stands on, the citations she shows her work with, and the record she can add to but
            never revise.
          </p>
        </div>

        <div class="audit-grid">
          <!-- 01 · the corpus -->
          <div class="card">
            <div class="card-head">
              <div class="kicker-sm">01 · Read the corpus</div>
              <h3>The reasoning is published.</h3>
              <p>Seventy-six papers, publicly indexed. These are load-bearing — Elle cites them by name.</p>
            </div>
            <div class="doc-list">
              {
                CORPUS_DOCS.map((doc) => (
                  <a href="/core-works">
                    <span class="t">{doc.title}</span>
                    <span class="v">{doc.version}</span>
                  </a>
                ))
              }
            </div>
            <div class="card-foot">
              <a href={PHILPEOPLE} class="link-mono">Open the full index on PhilPeople →</a>
            </div>
          </div>

          <!-- 02 · sourced answers -->
          <div class="card">
            <div class="card-head">
              <div class="kicker-sm">02 · Watch her show the work</div>
              <h3>Every answer carries its sources.</h3>
              <p>Not a confidence score. The actual documents the answer came from, listed under it.</p>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:14px">
              <div class="bubble-you">Does your framework treat coherence as measurable, or is that a metaphor?</div>
              <div class="bubble-elle">
                Measurable — κ(T,t) is defined as a live scalar over a thread, not a figure of speech. It falls when a
                line of thought drifts from its anchor and rises when it holds. The derivation is in <em>The Plenum</em
                >; the applied case is in <em>The Harmonizer</em>.
              </div>
              <div class="grounded">
                <div class="hd">Grounded in</div>
                <a href="/core-works"><span>The Plenum · v3</span><span>§4.2 →</span></a>
                <a href="/core-works"><span>The Harmonizer · v3-rev</span><span>§2 →</span></a>
                <a href="/core-works"><span>NECAI-F · v1</span><span>§7 →</span></a>
              </div>
            </div>
            <div class="card-foot">
              <a href="/elle" class="link-mono">Ask her something harder →</a>
            </div>
          </div>

          <!-- 03 · the record -->
          <div class="card">
            <div class="card-head">
              <div class="kicker-sm">03 · Audit the record</div>
              <h3>Corrections go on top. Nothing is erased.</h3>
              <p>
                The Optimus journal is append-only. A wrong entry stays wrong, in public, with the correction above it.
              </p>
            </div>
            <div class="card-body">
              {
                JOURNAL.map((j) => (
                  <div class="tl-item">
                    <span class="dot" style={`background:${j.dot}`} />
                    <div class="meta" style={`color:${j.metaColor}`}>
                      {j.meta}
                    </div>
                    <div class="text">{j.text}</div>
                  </div>
                ))
              }
              <div class="kappa">
                <span class="val">κ 0.72 ▲</span>
                <span class="bar"><i style="width:72%"></i></span>
              </div>
            </div>
            <div class="card-foot">
              <a href="/optimus" class="link-mono">Open a journal of your own →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ THE LOOP ============ -->
    <section class="on-base">
      <div class="shell sec-y">
        <div class="split split-flip">
          <div>
            <div class="kicker">How it holds together</div>
            <h2 class="h2-sm">One intelligence. Not a fleet of chatbots.</h2>
            <div class="prose" style="margin-top:22px">
              <p>
                Every door on this site reaches the same single mind — one loop, one memory, one corpus. What changes
                per door is what she's allowed to touch.
              </p>
              <p>
                The loop below is the whole architecture. It is deliberately short, because every step you can't see is
                a step you have to take on faith.
              </p>
            </div>
          </div>
          <div class="steps">
            {
              LOOP.map((p) => (
                <div class="step">
                  <div class="n">{p.n}</div>
                  <div>
                    <div class="k">{p.k}</div>
                    <div class="v">{p.v}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ THE INSTRUMENTS ============ -->
    <section id="intelligence">
      <div class="shell sec-y">
        <div
          style="display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:48px;flex-wrap:wrap"
        >
          <div style="max-width:640px">
            <div class="kicker">The instruments</div>
            <h2>Five tools. One free account.</h2>
            <p class="lede" style="margin-top:18px">
              Each one is labelled with what it actually is today — live, in beta, or built to order. Nothing here is a
              roadmap dressed as a product.
            </p>
          </div>
          <a href="/pricing" class="link-mono" style="white-space:nowrap;padding-bottom:6px">Create a free account →</a>
        </div>
        <div class="tools">
          {
            TOOLS.map((t) => (
              <a href={t.href} class:list={['tool', { 'is-gold': t.gold }]} style={`grid-column:span ${t.span}`}>
                <div class="top">
                  <div class="kick">{t.kicker}</div>
                  <div class:list={['chip', { 'is-live': t.live }]}>{t.state}</div>
                </div>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
                <div class="tags">
                  {t.facts.map((f) => (
                    <span>{f}</span>
                  ))}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ THE FOUR THINGS UNDER TEST ============ -->
    {
      TESTBEDS.map((s) => (
        <section id={s.id} class:list={[{ 'on-base': s.onBase }]}>
          <div class="shell sec-y">
            <div class="split">
              <div>
                <div class="kicker">{s.kicker}</div>
                <h2 class="h2-sm">{s.title}</h2>
                <div class="prose" style="margin-top:22px">
                  {s.paras.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
                <div class="btn-row" style="margin-top:30px">
                  <a href={s.ctaHref} class="btn btn-ghost btn-sm">
                    {s.cta}
                  </a>
                </div>
              </div>
              <div>
                <div class="facts">
                  {s.facts.map((f) => (
                    <div class="row">
                      <span class="k">{f.k}</span>
                      <span class="v">{f.v}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- ============ NINE ENGINES ============ -->
    <section id="engines" class="on-base">
      <div class="shell sec-y">
        <div class="sec-head" style="max-width:700px;margin-bottom:48px">
          <div class="kicker">Coverage</div>
          <h2>Nine engines, honestly labelled.</h2>
          <p class="lede" style="margin-top:18px">
            Elle doesn't become a different intelligence per domain — she changes what she's holding. Some of these are
            running today. Some are answered through the chat while the dedicated surface is built. We say which.
          </p>
        </div>
        <div class="engines">
          {
            ENGINES.map((e) => (
              <a href={e.href}>
                <span class="n">{e.n}</span>
                <span class="name">{e.name}</span>
                <span class="tag">{e.tag}</span>
                <span class:list={['state', { 'is-live': e.live }]}>{e.state}</span>
                <span class="arrow">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ COMMITMENTS ============ -->
    <section id="principles">
      <div class="shell sec-y">
        <div class="sec-head" style="max-width:700px;margin-bottom:52px">
          <div class="kicker">Commitments</div>
          <h2>Ethics as architecture, not disclaimer.</h2>
          <p class="lede" style="margin-top:18px">
            A principle you can't be held to is marketing. Each of these is paired with the mechanism that enforces it —
            the thing you could point at if we broke the promise.
          </p>
        </div>
        <div class="principles">
          {
            PRINCIPLES.map((p) => (
              <div>
                <h3>{p.name}</h3>
                <p>{p.body}</p>
                <div class="by">Enforced by</div>
                <div class="mech">{p.mechanism}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ WHO'S BEHIND IT ============ -->
    <section id="who" class="on-base">
      <div class="shell sec-y">
        <div class="split">
          <div>
            <div class="kicker">Who's behind it</div>
            <h2 class="h2-sm">One person, building in the open.</h2>
            <div class="prose" style="margin-top:22px">
              <p>
                The Ethical Intelligence Project is built and operated directly by <strong>Stewart Barteau</strong>. The
                commercial side runs pre-LLC on purpose: the beta should prove itself before the paperwork does.
              </p>
              <p>
                <strong>The Observer</strong> runs as an independent research initiative — not yet a 501(c)(3) — with its
                own transparency and funding-ethics disclosures.
              </p>
              <p>
                If you're press, a funder, or a researcher who wants the unvarnished version of any of this, ask. There
                is no communications team to route around.
              </p>
            </div>
            <div class="btn-row" style="margin-top:30px">
              <a href="/contact" class="btn btn-ghost btn-sm">Get in touch</a>
              <a href="/mission" class="btn btn-ghost btn-sm">Read the full philosophy</a>
            </div>
          </div>
          <div>
            <div class="facts">
              {
                PROJECT_FACTS.map((f) => (
                  <div class="row">
                    <span class="k">{f.k}</span>
                    <span class="v">{f.v}</span>
                  </div>
                ))
              }
            </div>
            <div class="follow-hd">Follow the work</div>
            <div class="socials">{SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta">
      <div class="wash"></div>
      <div class="inner">
        <h2>Free during beta. The rate you join at is the rate you keep.</h2>
        <p>
          One account opens the journal, the analysis engine, the courses, and Elle herself. No card, about thirty
          seconds.
        </p>
        <div class="btn-row">
          <a href="/pricing" class="btn btn-gold">Create a free account</a>
          <a href="/elle" class="btn btn-ghost">Talk to Elle first</a>
        </div>
      </div>
    </section>

    <EipFooter />
    <HubAuth />
  </div>

  <!-- Elle chat widget — same live worker endpoint the previous homepage used -->
  <script is:inline src={`${WORKER_URL}/widget.js`} data-title="Elle" data-accent="#c9a84c" defer></script>

  <script is:inline define:vars={{ PHRASES }}>
    (function () {
      const el = document.getElementById('eip-phrase');
      if (!el || el.dataset.wired) return;
      el.dataset.wired = '1';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let i = 0;
      // 6.5s hold, then drift out over 1.1s before the next phrase drifts in
      setInterval(function () {
        el.classList.add('is-out');
        setTimeout(function () {
          i = (i + 1) % PHRASES.length;
          el.textContent = PHRASES[i];
          el.classList.remove('is-out');
        }, 1150);
      }, 6500);
    })();
  </script>
</Layout>
