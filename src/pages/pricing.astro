---
// ============================================================
// PRICING — from the "Pricing" screen in EIP - Pages.dc.html.
//
// Every CTA still routes through window.EIH (HubAuth) exactly as the previous
// version did: signed in → straight to /optimus, otherwise the Google sign-up
// modal. No payment is collected during beta; the plans record the rate a
// member locks in.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';

const metadata = {
  title: 'Pricing — The Ethical Intelligence Project',
  description:
    'Join free during beta and keep the rate you joined at. No card, nothing to cancel — the prices here are what takes effect when billing turns on.',
};

const PLANS = [
  {
    name: 'Free',
    price: '$0',
    per: 'always',
    now: 'No account needed for the courses',
    body: 'Guest access to Elle, all four Atlas Edu courses, the corpus, and everything The Observer publishes.',
    featured: false,
    items: [
      'Guest conversations with Elle',
      'All four courses, in full',
      'The published corpus',
      'The Observer archive',
    ],
    cta: 'Start reading',
  },
  {
    name: 'Standard',
    price: '$10',
    per: '/mo after beta',
    now: 'Free during beta · locked at $10',
    body: 'The whole hub: your append-only journal, the analysis engine, and Elle with full corpus reasoning and memory.',
    featured: true,
    items: [
      'Everything in Free',
      'Optimus Journal + manuscript reader',
      'Analysis Engine, 16 axes per run',
      'Full corpus reasoning and memory',
      '60 requests per hour',
    ],
    cta: 'Join the beta — free',
  },
  {
    name: 'Plus',
    price: '$20',
    per: '/mo after beta',
    now: 'Free during beta · locked at $20',
    body: 'For people who want to shape what gets built. Same tools, higher ceilings, a direct line.',
    featured: false,
    items: [
      'Everything in Standard',
      'Higher rate ceiling',
      'Priority support, answered by a person',
      'Direct input on the roadmap',
    ],
    cta: 'Join at the Plus rate',
  },
];

const FAQS = [
  {
    q: 'Is the beta really free?',
    a: 'Yes. Sign in with Google, no card, nothing to cancel. Nothing is charged and no payment details are collected during beta.',
  },
  {
    q: 'What happens when beta ends?',
    a: 'Billing starts at whichever rate you joined at — $10 or $20 — and you are told well before anything is charged. If you joined during beta, that rate does not go up.',
  },
  {
    q: 'What do you do with my conversations?',
    a: 'Nothing. They are not sold and not used as training data. You can export the whole record or delete your account and everything in it, from the account menu.',
  },
  {
    q: 'Can I switch plans later?',
    a: 'Any time. Reach out and we will move you — the locked beta rate follows you to the tier you move to.',
  },
  {
    q: 'Why is a pre-LLC project charging money?',
    a: 'It is not, yet. The beta is free precisely because the structure is still forming. The rates above exist so early users know what they are agreeing to before it does.',
  },
];
---

<EipPage metadata={metadata} current="/pricing">
  <section>
    <div class="shell" style="padding-top:96px;padding-bottom:60px;text-align:center">
      <div class="kicker">Public beta · nothing is being charged</div>
      <h1>Join free. Keep the rate you joined at.</h1>
      <p class="lede" style="max-width:600px;margin:0 auto">
        No card, nothing to cancel. The prices below are what takes effect when billing turns on — and beta members stay
        at the rate they signed up at, indefinitely.
      </p>
    </div>
  </section>

  <section class="on-base">
    <div class="shell" style="padding-top:76px;padding-bottom:76px">
      <div class="plans">
        {
          PLANS.map((p) => (
            <div class:list={['plan', { 'is-featured': p.featured }]}>
              <div class="top">
                <span class="nm">{p.name}</span>
                {p.featured && <span class="flag">Most joined</span>}
              </div>
              <div class="price">
                <b>{p.price}</b>
                <span>{p.per}</span>
              </div>
              <div class="now">{p.now}</div>
              <p>{p.body}</p>
              <div class="items">
                {p.items.map((i) => (
                  <div>
                    <i>✓</i>
                    <span>{i}</span>
                  </div>
                ))}
              </div>
              <button class="go plan-cta" type="button">
                {p.cta}
              </button>
            </div>
          ))
        }
      </div>
      <p style="text-align:center;font-family:var(--mono);font-size:0.7rem;color:var(--t3);margin:26px 0 0">
        No payment is collected during beta. Pick the rate you want to lock in — you can move later.
      </p>
    </div>
  </section>

  <section>
    <div class="shell-narrow sec-y">
      <h2 class="h2-sm" style="margin-bottom:36px">Questions people actually ask</h2>
      <div class="faqs">
        {
          FAQS.map((f) => (
            <div class="row">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      // unchanged behaviour: signed in → the journal, otherwise the sign-up modal
      function joinBeta() {
        if (window.EIH && window.EIH.getToken()) {
          window.location.href = '/optimus';
        } else if (window.EIH) {
          window.EIH.openAuth('signup');
        }
      }
      document.querySelectorAll('.plan-cta').forEach(function (btn) {
        btn.addEventListener('click', joinBeta);
      });
    })();
  </script>
</EipPage>
