---
// ============================================================
// ABOUT — from the "About" screen in EIP - Pages.dc.html.
//
// Two corrections from the design conversation are applied here: The Observer
// is an independent research initiative (NOT a 501(c)(3)), and there are no
// "Hermann, Missouri" references — the previous version of this page carried
// both.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';
import { ENGINES, PROJECT_FACTS } from '~/eip';

const metadata = {
  title: 'About — The Ethical Intelligence Project',
  description:
    'Community-based intelligence infrastructure, powered by Elle — one corpus-grounded intelligence with a memory she can see but never rewrite. Built and operated directly by Stewart Barteau.',
};
---

<EipPage metadata={metadata} current="/about">
  <section class="page-hero">
    <div class="inner">
      <div class="kicker">About</div>
      <h1>Intelligence built to serve the people doing the work.</h1>
      <p class="lede">
        Community-based intelligence infrastructure, powered by Elle — one corpus-grounded intelligence with a memory
        she can see but never rewrite. It exists for people who don't have a staff of lawyers or analysts standing by,
        and it is built so the people it serves can check the work.
      </p>
    </div>
  </section>

  <section class="on-base">
    <div class="shell sec-y">
      <div class="split split-flip">
        <div>
          <div class="kicker">Who's behind it</div>
          <h2 class="h2-sm">One person, building in the open.</h2>
          <div class="prose" style="margin-top:22px">
            <p>
              Built and operated directly by <strong>Stewart Barteau</strong>. The commercial side — Elle, Optimus, the
              Analysis Engine, Atlas Edu, the Small Business Hub — runs pre-LLC on purpose, so the beta proves itself
              before the paperwork does.
            </p>
            <p>
              <strong>The Observer</strong> runs as an independent research initiative — not yet a 501(c)(3) — with its own
              public transparency and funding-ethics disclosures.
            </p>
            <p>
              Elle is built on four frameworks — NECAI-F, the Observer Series, RBDA and κ(T,t) — that treat coherence as
              measurable rather than claimed. The short version: don't flatten a live question, hold many readings at
              once, anchor so you can't quietly drift, and keep a live number for how well it is holding together.
            </p>
          </div>
        </div>
        <div>
          <div class="kicker">The facts</div>
          <div class="facts">
            {
              PROJECT_FACTS.map((f) => (
                <div class="row">
                  <span class="k">{f.k}</span>
                  <span class="v">{f.v}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="shell sec-y">
      <div class="kicker">Coverage</div>
      <h2 class="h2-sm" style="margin-bottom:36px">Nine engines, honestly labelled.</h2>
      <div class="engines">
        {
          ENGINES.map((e) => (
            <a href={e.href}>
              <span class="n">{e.n}</span>
              <span class="name">{e.name}</span>
              <span class="tag">{e.tag}</span>
              <span class:list={['state', { 'is-live': e.live }]}>{e.state}</span>
              <span class="arrow">→</span>
            </a>
          ))
        }
      </div>
      <div class="btn-row" style="margin-top:40px">
        <a href="/mission" class="btn btn-ghost btn-sm">Read the mission</a>
        <a href="/contact" class="btn btn-ghost btn-sm">Get in touch</a>
      </div>
    </div>
  </section>
</EipPage>
