---
// ============================================================
// MADMIND INSTITUTE — Corpus landing (glass UI, cosmic rebrand)
// A self-contained "satin black + gold + teal + violet" glassmorphism
// landing for the MadMind Institute research corpus (an independent
// research initiative of the Ethical Intelligence Project). A darkened,
// motion-looped orbital field ("Mad Mind" atomic reveal) sits fixed
// behind the glass panels as living texture.
//
// Rendered on the bare Layout so it owns the full viewport; all styles
// are scoped under #eipg to avoid colliding with the site-wide
// .btn / .tag / .wrap globals. Body/html overrides + the fixed media
// layer use :global()/position:fixed — View Transitions strips the
// page styles on navigation, so nothing leaks onto other routes.
// ============================================================
import Layout from '~/layouts/Layout.astro';
import { READER_CITIES } from '~/data/reader-cities';

// The reach map draws the one canonical reader-city list (see
// src/data/reader-cities.ts) — the same list the hero globe renders.
// Passed into the inline canvas script rather than duplicated here.
const reachCities = READER_CITIES.map((c) => [c.name, c.lat, c.lon, c.tier]);

const metadata = {
  title: 'MadMind Institute — The Corpus',
  description:
    'The MadMind Institute: an independent research corpus on consciousness, sovereignty, identity, and phase-state dynamics — co-authored with AI as genuine intellectual partnership, read by institutions across four continents. An independent research initiative of the Ethical Intelligence Project.',
};
---

<Layout metadata={metadata}>
  <div id="eipg">
    <!-- Fixed cosmic-orbital media field behind the glass. Muted, looped,
         darkened; poster (and reduced-motion) fall back to a still frame. -->
    <div class="bg-media" aria-hidden="true">
      <video autoplay muted loop playsinline preload="metadata" poster="/media/madmind-poster.jpg">
        <source src="/media/madmind-hero.mp4" type="video/mp4" />
      </video>
      <div class="bg-scrim"></div>
    </div>

    <nav class="site-nav glass">
      <a class="logo" href="/">
        <div class="globe"></div>
        <div>
          MadMind Institute<small>An independent research initiative of the Ethical Intelligence Project</small>
        </div>
      </a>
      <div class="nav-links">
        <a class="nav-link" href="#corpus">Corpus</a>
        <a class="nav-link" href="#frameworks">Frameworks</a>
        <a class="nav-link" href="#journal">Journal</a>
        <a class="nav-link" href="/edu">Edu</a>
        <a class="nav-link" href="/about">About</a>
      </div>
      <a class="btn gold" href="#corpus">Read the work</a>
      <button class="mnav-burger" id="eipg-burger" aria-label="Menu"><span></span><span></span><span></span></button>
      <div class="mnav-drawer" id="eipg-drawer">
        <a href="#corpus">Corpus</a>
        <a href="#frameworks">Frameworks</a>
        <a href="#journal">Journal</a>
        <a href="/edu">Edu</a>
        <a href="/about">About</a>
      </div>
    </nav>

    <div class="wrap">
      <!-- HERO -->
      <section class="hero">
        <div>
          <span class="tag violet">MadMind Institute · Independent Philosophy · Zero Promotion</span>
          <h1>The optimal form is never built.<br /><em>It is allowed.</em></h1>
          <p class="lede">
            The research corpus of the MadMind Institute — on consciousness, sovereignty, identity, and phase-state
            dynamics. Co-authored with AI as genuine intellectual partnership, and read by institutions across four
            continents without a single press release.
          </p>
          <div class="hero-ctas">
            <a class="btn gold" href="#corpus">Enter the corpus</a>
            <a class="btn" href="#method">How it's made</a>
          </div>
          <div class="hero-proof">
            <div class="proof"><b>29+</b><span>Papers</span></div>
            <div class="proof"><b>17+</b><span>Institutions</span></div>
            <div class="proof"><b>4</b><span>Continents</span></div>
            <div class="proof"><b>Top 2%</b><span>PhilPeople</span></div>
          </div>
        </div>
      </section>

      <!-- REACH -->
      <div id="reach" class="sec-h"><span class="num">I</span><h2>The Reach</h2><div class="rule"></div></div>
      <p class="reach-intro">
        No institutional affiliation, no marketing, no push — just the work, posted to an open archive. Over roughly
        eight weeks (June–August 2026), PhilArchive's own logs place the corpus in <strong
          >80+ cities across 45+ countries and all six inhabited continents</strong
        >, opened along the way from named university networks. Every point on the map below is a real reader city
        pulled from that log.
      </p>
      <div class="reach-stats">
        <div class="r-stat glass"><div class="r-n">10,000+</div><div class="r-l">downloads, unpromoted</div></div>
        <div class="r-stat glass"><div class="r-n">45+</div><div class="r-l">countries in the readership log</div></div>
        <div class="r-stat glass"><div class="r-n">80+</div><div class="r-l">reader cities, six continents</div></div>
        <div class="r-stat glass">
          <div class="r-n">21+</div><div class="r-l">confirmed reader institutions (PhilPeople-verified)</div>
        </div>
      </div>

      <div class="reach-map glass">
        <canvas
          id="reachmap"
          role="img"
          aria-label="World signal map: each point marks a city where the corpus was opened, spanning all six inhabited continents."
        ></canvas>
        <div class="map-cap">
          <span class="dotk" aria-hidden="true"></span> each point is a city where the corpus was opened · source: the PhilArchive
          readership log, Jun–Aug 2026
        </div>
      </div>

      <div class="uni-head">Confirmed reader institutions — labeled by thread where a specific paper is logged</div>
      <div class="uni-grid">
        <div class="uni glass">
          <div class="u-name">University of Michigan</div><div class="u-loc">Ann Arbor, USA · Math</div><div
            class="u-doc"
          >
            The Markov Blanket at Scale
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">John Carroll University</div><div class="u-loc">Ohio, USA · Philosophy</div><div
            class="u-doc"
          >
            The 20th Century Objection · The External Factor · The Driving Mechanism
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Queen's University Belfast</div><div class="u-loc">Northern Ireland · Philosophy</div><div
            class="u-doc"
          >
            War in Superposition
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">KU Leuven</div><div class="u-loc">Belgium</div><div class="u-doc">
            Gravity and the Ground
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Massey University</div><div class="u-loc">New Zealand</div><div class="u-doc">
            The First Note and the Octave
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Tasmania</div><div class="u-loc">Australia</div><div class="u-doc">
            The Substrate Identity Continuity Theorem
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Cambridge</div><div class="u-loc">UK</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Hebrew University of Jerusalem</div><div class="u-loc">Israel</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">National Sun Yat-sen University</div><div class="u-loc">Taiwan</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Universität Leipzig</div><div class="u-loc">Germany</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Western Ontario</div><div class="u-loc">Canada</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Montreal</div><div class="u-loc">Canada</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Oklahoma</div><div class="u-loc">USA</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Kansas</div><div class="u-loc">USA</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Florida Atlantic University</div><div class="u-loc">USA</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Iowa State University</div><div class="u-loc">USA</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">Boston University</div><div class="u-loc">USA · unconfirmed</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">NYU</div><div class="u-loc">USA</div><div class="u-doc">general corpus readership</div>
        </div>
        <div class="uni glass">
          <div class="u-name">UIC</div><div class="u-loc">USA</div><div class="u-doc">general corpus readership</div>
        </div>
        <div class="uni glass">
          <div class="u-name">SUTD</div><div class="u-loc">Singapore</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
        <div class="uni glass">
          <div class="u-name">University of Gdansk</div><div class="u-loc">Poland</div><div class="u-doc">
            general corpus readership
          </div>
        </div>
      </div>
      <p class="reach-note">
        Confirmed directly from PhilPeople download notifications through roughly May 2026 — the true count is likely
        higher, since this roster lags live readership. Only the institutions above with a named paper have a confirmed
        thread; the rest show as general corpus readership because no specific paper was logged against them.
      </p>

      <!-- FRAMEWORKS -->
      <div id="frameworks" class="sec-h">
        <span class="num">II</span><h2>The Frameworks</h2><div class="rule"></div>
      </div>
      <div class="fw-grid">
        <div class="fw glass">
          <div class="fw-name">NECAI-F</div>
          <div class="fw-sub">
            Seven violation types governing all operations from the start — with premature collapse of superposition as
            the primary AI failure mode.
          </div>
          <div class="fw-status"><span class="tag gold">Governing constraint</span></div>
        </div>
        <div class="fw glass">
          <div class="fw-name">Observer Series</div>
          <div class="fw-sub">
            Recursive palimpsest superposition across 16+ axes. Three-tier engine architecture, 280 events, 12 eras.
          </div>
          <div class="fw-status"><span class="tag">Architecture</span></div>
        </div>
        <div class="fw glass">
          <div class="fw-name">RBDA</div>
          <div class="fw-sub">
            Recursive Backcross Drift Architecture for AI training, anchored by sealed corpus and external human
            testimony.
          </div>
          <div class="fw-status"><span class="tag">Provisional patent</span></div>
        </div>
        <div class="fw glass">
          <div class="fw-name">κ(T,t)</div>
          <div class="fw-sub">
            The biometric coherence function — a candidate invariant of intelligence under compression, held to a
            kill-or-build falsification gate.
          </div>
          <div class="fw-status"><span class="tag teal">Pre-validation</span></div>
        </div>
      </div>

      <!-- CORPUS -->
      <div id="corpus" class="sec-h"><span class="num">III</span><h2>The Corpus</h2><div class="rule"></div></div>
      <div class="corpus-tools">
        <div class="filter active">All</div>
        <div class="filter">Mad Mind Series</div>
        <div class="filter">Observer Series</div>
        <div class="filter">Phase-State</div>
        <div class="filter">Political-Structural</div>
        <div class="filter">Captured Resonance</div>
      </div>
      <div class="corpus-grid">
        <div class="paper glass">
          <span class="series">Mad Mind Series</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilArchive</span><span>2026 · Co-authored</span></div>
        </div>
        <div class="paper glass">
          <span class="series">Observer Series</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilPeople</span><span>Top 2%</span></div>
        </div>
        <div class="paper glass">
          <span class="series">Phase-State</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilArchive</span><span>2026</span></div>
        </div>
        <div class="paper glass">
          <span class="series">Political-Structural</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilArchive</span><span>2025</span></div>
        </div>
        <div class="paper glass">
          <span class="series">Captured Resonance</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilArchive</span><span>2025</span></div>
        </div>
        <div class="paper glass">
          <span class="series">Mad Mind Series</span>
          <div class="p-title">Paper title runs here across two comfortable lines</div>
          <div class="p-abs">One-sentence abstract giving the reader the thesis without requiring the click.</div>
          <div class="p-meta"><span>PhilArchive</span><span>2025</span></div>
        </div>
      </div>
      <div class="corpus-more"><button class="btn">View all 29+ papers</button></div>

      <!-- METHODOLOGY -->
      <div id="method" class="sec-h"><span class="num">IV</span><h2>The Method</h2><div class="rule"></div></div>
      <div class="method glass">
        <blockquote>
          "Kill-or-build. Nothing ranks until it survives its own falsification gate."
          <footer>The discipline behind every claim</footer>
        </blockquote>
        <div class="method-copy">
          <p>
            Every framework in the corpus is pressure-tested against pre-registered decision rules — explicit BUILD /
            REVISE / KILL criteria written before the evidence arrives.
          </p>
          <p>
            Papers are co-authored with AI as a standing methodology: not tool use, but documented intellectual
            partnership, with the process itself as part of the research record.
          </p>
        </div>
      </div>

      <!-- JOURNAL -->
      <div id="journal" class="sec-h">
        <span class="num">V</span><h2>Sitting with a Mad Mind</h2><div class="rule"></div>
      </div>
      <div class="journal-grid">
        <div class="j-hero glass">
          <span class="tag gold">Letters to MadMinds · Prelude</span>
          <div class="j-title">The Day I Stopped Asking What Was Wrong</div>
          <div class="j-dek">
            The opening letter of the series — on the question that had to be abandoned before the work could begin.
          </div>
          <div class="j-meta">
            <span>Essay</span><span>·</span><span>12 min</span><span>·</span><span>Substack</span>
          </div>
        </div>
        <div class="j-list">
          <div class="j-row glass"><b>Recent letter title</b><span>Letters to MadMinds · date</span></div>
          <div class="j-row glass"><b>Recent letter title</b><span>Letters to MadMinds · date</span></div>
          <div class="j-row glass"><b>Recent letter title</b><span>Essay · date</span></div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="wrap">
        <div class="f-grid">
          <div>
            <div class="logo" style="margin-bottom:12px;">
              <div class="globe"></div><div>MadMind Institute</div>
            </div>
            <div class="f-mission">
              The research corpus of the MadMind Institute — an independent research initiative of the Ethical
              Intelligence Project. The corpus and public platform are held by EIP; the frameworks are governed by
              NECAI-F from the start, not as a post-hoc filter.
            </div>
          </div>
          <div class="f-col">
            <b>Work</b><a href="#corpus">The Corpus</a><a href="#frameworks">Frameworks</a><a href="#journal">Journal</a
            ><a href="#">PhilArchive ↗</a>
          </div>
          <div class="f-col">
            <b>Project</b><a href="/about">About</a><a href="#method">Methodology</a><a href="#">Readership</a><a
              href="/contact">Contact</a
            >
          </div>
          <div class="f-col">
            <b>Ecosystem</b><a href="#">RAPID²AI ↗</a><a href="/edu">Atlas Edu ↗</a><a href="#">Substack ↗</a>
          </div>
        </div>
        <div class="f-bottom">
          <span>© 2026 MadMind Institute · an independent research initiative of the Ethical Intelligence Project</span>
          <span class="f-motto">Always was. Always will be.</span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  #eipg {
    --bg: #0a0a0c;
    --surface: rgba(255, 255, 255, 0.05);
    --surface-strong: rgba(255, 255, 255, 0.095);
    --border: rgba(255, 255, 255, 0.13);
    --border-bright: rgba(255, 255, 255, 0.28);
    --gold: #d9b26a;
    --gold-bright: #eccf97;
    --gold-dim: rgba(217, 178, 106, 0.14);
    --teal: #37e0c8;
    --teal-dim: rgba(55, 224, 200, 0.12);
    --violet: #9d8be0;
    --violet-bright: #c4b6f5;
    --violet-dim: rgba(139, 123, 216, 0.14);
    --text: #f0efe9;
    --text-dim: rgba(240, 239, 233, 0.6);
    --text-faint: rgba(240, 239, 233, 0.34);
    --r: 14px;
    --r-btn: 8px;
    --blur: 20px;
    --snap: 140ms cubic-bezier(0.2, 0.9, 0.3, 1);
    --serif: 'Georgia', 'Times New Roman', serif;

    color: var(--text);
    font-family:
      'Inter',
      -apple-system,
      'Segoe UI',
      sans-serif;
    font-size: 14.5px;
    line-height: 1.55;
    min-height: 100vh;
    position: relative;
  }
  #eipg * {
    box-sizing: border-box;
  }
  /* Content sits above the fixed media field. */
  #eipg .site-nav,
  #eipg .wrap,
  #eipg .site-footer {
    position: relative;
    z-index: 1;
  }

  /* ===== FIXED COSMIC MEDIA FIELD ===== */
  #eipg .bg-media {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  #eipg .bg-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Near-monochrome: strip most of the color so the orbital reads as a
       serious dark texture, not a colorful graphic. Deep + desaturated. */
    filter: brightness(0.34) saturate(0.28) contrast(1.06);
  }
  #eipg .bg-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1100px 620px at 74% -8%, rgba(217, 178, 106, 0.06), transparent 62%),
      linear-gradient(180deg, rgba(10, 10, 12, 0.72) 0%, rgba(10, 10, 12, 0.84) 55%, rgba(10, 10, 12, 0.93) 100%);
  }
  /* Reduced motion / no-JS fallback: hide the video, keep the poster still. */
  @media (prefers-reduced-motion: reduce) {
    #eipg .bg-media video {
      display: none;
    }
    #eipg .bg-media {
      background: #0a0a0c url('/media/madmind-poster.jpg') center / cover no-repeat;
    }
  }

  /* Page-level base color + smooth scroll. :global() so it paints the full
     viewport under the media field; View Transitions removes it on nav. */
  :global(html:has(#eipg)) {
    scroll-behavior: smooth;
  }
  :global(body:has(#eipg)) {
    background: #0a0a0c;
  }

  #eipg .glass {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    backdrop-filter: blur(var(--blur)) saturate(1.3);
    -webkit-backdrop-filter: blur(var(--blur)) saturate(1.3);
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.09);
  }
  #eipg .btn {
    display: inline-block;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: var(--r-btn);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition:
      background var(--snap),
      border-color var(--snap),
      transform var(--snap);
    backdrop-filter: blur(var(--blur));
  }
  #eipg .btn:hover {
    background: var(--surface-strong);
    border-color: var(--border-bright);
    transform: translateY(-1px);
  }
  #eipg .btn.gold {
    background: var(--gold-dim);
    border-color: rgba(217, 178, 106, 0.5);
    color: var(--gold-bright);
  }
  #eipg .btn.gold:hover {
    background: rgba(217, 178, 106, 0.24);
    box-shadow: 0 0 24px rgba(217, 178, 106, 0.18);
  }
  #eipg .tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border-radius: 6px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    color: var(--text-dim);
  }
  #eipg .tag.gold {
    border-color: rgba(217, 178, 106, 0.45);
    color: var(--gold);
    background: var(--gold-dim);
  }
  #eipg .tag.teal {
    border-color: rgba(55, 224, 200, 0.4);
    color: var(--teal);
    background: var(--teal-dim);
  }
  #eipg .tag.violet {
    border-color: rgba(139, 123, 216, 0.45);
    color: var(--violet-bright);
    background: var(--violet-dim);
  }
  #eipg .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ===== NAV ===== */
  #eipg .site-nav {
    position: sticky;
    top: 14px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1180px;
    margin: 16px auto 0;
    padding: 10px 12px 10px 18px;
  }
  #eipg .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 700;
    font-size: 15px;
  }
  #eipg .logo small {
    display: block;
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  #eipg .globe {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    flex: none;
    background:
      radial-gradient(circle at 35% 30%, rgba(217, 178, 106, 0.55), transparent 60%),
      conic-gradient(
        from 20deg,
        transparent 0 42%,
        rgba(55, 224, 200, 0.35) 50%,
        transparent 58%,
        rgba(139, 123, 216, 0.32) 74%,
        transparent 82%
      );
    box-shadow:
      0 0 20px rgba(217, 178, 106, 0.35),
      0 0 30px rgba(139, 123, 216, 0.18);
  }
  #eipg .nav-links {
    display: flex;
    gap: 2px;
  }
  #eipg .nav-link {
    padding: 8px 14px;
    border-radius: var(--r-btn);
    font-size: 13px;
    color: var(--text-dim);
    text-decoration: none;
