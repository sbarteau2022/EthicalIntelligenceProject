<script is:inline>
  (function () {
    const burger = document.getElementById('eipg-burger');
    const drawer = document.getElementById('eipg-drawer');
    if (!burger || !drawer) return;
    burger.addEventListener('click', function () {
      drawer.classList.toggle('open');
    });
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        drawer.classList.remove('open');
      });
    });
    document.addEventListener('click', function (e) {
      if (
        drawer.classList.contains('open') &&
        !drawer.contains(e.target) &&
        e.target !== burger &&
        !burger.contains(e.target)
      ) {
        drawer.classList.remove('open');
      }
    });
  })();
</script>

<script is:inline define:vars={{ reachCities }}>
  // Global reach — a world signal map of real reader cities from the PhilArchive log
  (function () {
    const c = document.getElementById('reachmap');
    if (!c) return;
    const ctx = c.getContext('2d');
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    let W = 0,
      H = 0,
      pad = 0;

    // [name, lat, lng, weight] — the canonical list, injected from
    // src/data/reader-cities.ts so this map and the hero globe can never drift.
    const cities = reachCities;

    const conts = [
      ['NORTH AMERICA', 46, -100],
      ['SOUTH AMERICA', -14, -62],
      ['EUROPE', 57, 10],
      ['AFRICA', 2, 21],
      ['ASIA', 50, 95],
      ['OCEANIA', -27, 140],
    ];

    function proj(lat, lng) {
      return { x: pad + ((lng + 180) / 360) * (W - 2 * pad), y: pad + ((90 - lat) / 180) * (H - 2 * pad) };
    }
    function css(v) {
      return getComputedStyle(document.getElementById('eipg')).getPropertyValue(v).trim();
    }
    function size() {
      const r = c.getBoundingClientRect();
      W = r.width;
      H = Math.round(W * 0.52);
      pad = Math.max(10, W * 0.03);
      c.style.height = H + 'px';
      c.width = W * dpr;
      c.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    size();
    window.addEventListener('resize', function () {
      size();
      if (reduce) frame(0);
    });

    function frame(t) {
      const gold = css('--gold') || '#d9b26a';
      const hair = css('--border') || 'rgba(255,255,255,0.13)';
      const muted = css('--text-faint') || 'rgba(240,239,233,0.34)';
      ctx.clearRect(0, 0, W, H);

      // graticule
      ctx.strokeStyle = hair;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.6;
      for (let lo = -150; lo <= 150; lo += 30) {
        const a = proj(84, lo),
          b = proj(-84, lo);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
      for (let la = -60; la <= 60; la += 30) {
        const p0 = proj(la, -180),
          q0 = proj(la, 180);
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(q0.x, q0.y);
        ctx.stroke();
      }

      // continent labels
      ctx.fillStyle = muted;
      ctx.globalAlpha = 0.45;
      ctx.textAlign = 'center';
      ctx.font = '600 ' + Math.max(8, Math.round(W * 0.0105)) + 'px ui-monospace, monospace';
      for (let k = 0; k < conts.length; k++) {
        const pc = proj(conts[k][1], conts[k][2]);
        ctx.fillText(conts[k][0], pc.x, pc.y);
      }

      // city dots
      for (let i = 0; i < cities.length; i++) {
        const ci = cities[i],
          p = proj(ci[1], ci[2]);
        const base = ci[3] === 3 ? 3.1 : ci[3] === 2 ? 2.3 : 1.7;
        const ph = (i * 0.618034) % 1;
        const pulse = reduce ? 0.5 : 0.5 + 0.5 * Math.sin(t * 0.0016 + ph * 6.2832);
        ctx.fillStyle = gold;
        ctx.globalAlpha = 0.1 + 0.16 * pulse;
        ctx.beginPath();
        ctx.arc(p.x, p.y, base + 2.4 + 2.4 * pulse, 0, 6.2832);
        ctx.fill();
        ctx.globalAlpha = 0.92;
        ctx.beginPath();
        ctx.arc(p.x, p.y, base, 0, 6.2832);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!reduce) requestAnimationFrame(frame);
    }
    if (reduce) frame(0);
    else requestAnimationFrame(frame);
  })();
</script>
