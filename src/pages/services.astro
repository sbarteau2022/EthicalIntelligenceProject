---
// ============================================================
// THE CATALOG — the full "What's To Come" page behind the nav dropdown:
// standalone products and custom services, each labelled with what it
// actually is today.
//
// This replaces the AstroWind demo "Services" page (stock Unsplash imagery,
// template testimonials), which the brief cut along with the rest of the
// template leftovers.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';
import { PRODUCTS } from '~/eip';

const metadata = {
  title: 'The catalog — standalone products and custom services',
  description:
    'Every product runs on the same mind — one loop, one memory, one corpus. What changes per door is what she is allowed to touch.',
};

const live = PRODUCTS.filter((p) => p.state === 'Live');
const rest = PRODUCTS.filter((p) => p.state !== 'Live');
---

<EipPage metadata={metadata}>
  <section class="page-hero">
    <div class="tint" style="background:radial-gradient(ellipse 60% 60% at 80% 0%, #17140d 0%, transparent 62%)"></div>
    <div class="inner">
      <div class="kicker">Products · Individual</div>
      <h1>Standalone products and custom services.</h1>
      <p class="lede">
        Every one runs on the same mind — one loop, one memory, one corpus. What changes per door is what she's allowed
        to touch. Each is labelled with what it actually is today; nothing here is a roadmap dressed as a product.
      </p>
    </div>
  </section>

  <section class="on-base">
    <div class="shell sec-y">
      <div class="kicker">Open now</div>
      <h2 class="h2-sm" style="margin-bottom:34px">Running today.</h2>
      <div class="tiles c3">
        {
          live.map((p) => (
            <a href={p.href} class="tile">
              <div class="n">{p.state}</div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <div style="margin-top:auto;padding-top:22px" class="link-mono">
                Open →
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="shell sec-y">
      <div class="kicker">In beta, or built to order</div>
      <h2 class="h2-sm" style="margin-bottom:34px">What's to come.</h2>
      <div class="tiles c3">
        {
          rest.map((p) => (
            <a href={p.href} class="tile">
              <div class="n">{p.state}</div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <div style="margin-top:auto;padding-top:22px" class="link-mono">
                {p.state === 'By request' ? 'Scope it →' : 'Open the beta →'}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wash"></div>
    <div class="inner">
      <h2>One account opens all of it.</h2>
      <p>Free during beta, no card. The rate you join at is the rate you keep.</p>
      <div class="btn-row">
        <a href="/pricing" class="btn btn-gold">See the rates</a>
        <a href="/contact" class="btn btn-ghost">Scope something custom</a>
      </div>
    </div>
  </section>
</EipPage>
