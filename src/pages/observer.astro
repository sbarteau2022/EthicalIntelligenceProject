---
// ============================================================
// THE OBSERVER — from the "The Observer" screen in EIP - Pages.dc.html.
//
// The design file's hero kicker still read "501(c)(3)" even after the design
// conversation corrected that everywhere else; it reads as an independent
// research initiative here, which is what the user asked for.
// ============================================================
import EipPage from '~/components/eip/EipPage.astro';
import { PHILPEOPLE } from '~/eip';

const metadata = {
  title: 'The Observer — research and testimony',
  description:
    'Structural analysis with no side, published only when the analysis is ready. Five axes, every claim sourced, and the strongest argument against each conclusion printed beside it.',
};

const AXES = [
  {
    n: '1',
    name: 'The dominant narrative',
    body: 'What the mainstream account says is happening — stated as precisely and as fairly as the mainstream itself would state it.',
  },
  {
    n: '2',
    name: 'The counter-narrative',
    body: 'What the strongest opposition says is happening — stated with the same precision. No strawmen, no summary of the weakest version.',
  },
  {
    n: '3',
    name: 'The structural analysis',
    body: 'What is actually happening beneath both stories, traced back to the conditions that generate both motivated accounts.',
  },
  {
    n: '4',
    name: 'The dissent',
    body: "The strongest argument against the Observer's own analysis — what it might be missing — published alongside it with equal care.",
  },
  {
    n: '5',
    name: 'The prediction',
    body: 'What the historical pattern says comes next. Probability, not prophecy, with the base rate shown so you can check it later.',
  },
];

const CREDIBILITY = [
  { n: 'Top 1%', label: 'Publication volume, PhilPapers' },
  { n: 'Top 2%', label: 'Downloads, PhilPapers' },
  { n: '76+', label: 'Papers published' },
  { n: '18+', label: 'Universities reading the work' },
];
---

<EipPage metadata={metadata} current="/observer">
  <section class="page-hero">
    <div class="tint" style="background:radial-gradient(ellipse 60% 60% at 15% 0%, #14141f 0%, transparent 62%)"></div>
    <div class="inner">
      <div class="kicker">Research &amp; testimony · an independent research initiative</div>
      <h1>The publication that prints its own dissent.</h1>
      <p class="lede" style="margin-bottom:34px">
        The Observer applies structural analysis to what is actually happening — beneath the dominant story and beneath
        the counter-story. It publishes when the analysis is ready, never on a schedule. Every claim is sourced, every
        revision documented, and the strongest argument against each conclusion is printed beside it.
      </p>
      <div class="btn-row">
        <a href={PHILPEOPLE} class="btn btn-gold">Read the published work</a>
        <a href="/core-works" class="btn btn-ghost">Open the manuscript reader</a>
      </div>
    </div>
  </section>

  <section class="on-base">
    <div class="shell-narrow" style="padding-top:84px;padding-bottom:84px">
      <blockquote class="pullquote">
        "Neutrality is a position that refuses to see. The Observer sees everything — and has no stake in the outcome.
        If the structural truth disrupts one camp today and the other tomorrow, both disruptions are published with
        equal precision."
      </blockquote>
    </div>
  </section>

  <section>
    <div class="shell sec-y">
      <div class="kicker">The method</div>
      <h2 class="h2-sm" style="margin-bottom:44px">Five axes, applied to every piece.</h2>
      <div class="axes">
        {
          AXES.map((a) => (
            <div class="row">
              <span class="n">AXIS {a.n}</span>
              <h3>{a.name}</h3>
              <p>{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="on-base">
    <div class="shell sec-y">
      <div class="split" style="gap:72px">
        <div>
          <div class="kicker">The record</div>
          <h2 class="h2-sm">Not marketing standing in for rigor.</h2>
          <div class="prose" style="margin-top:22px">
            <p>
              The framework behind the Observer is published where it can be checked — philosophy, ethics and
              engineering built over fifteen years, co-authored with Claude. It is read, cited and taught. You don't
              have to trust it; you can go verify it.
            </p>
            <p>
              The testimony side preserves public records and holds permanent space for witness accounts — sealed and
              append-only, the same discipline as the Optimus journal, because a record that can be quietly rewritten
              isn't a record.
            </p>
          </div>
        </div>
        <div class="quad">
          {
            CREDIBILITY.map((c) => (
              <div>
                <div class="n">{c.n}</div>
                <div class="label">{c.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</EipPage>
